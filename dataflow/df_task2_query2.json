{
	"name": "df_task2_query2",
	"properties": {
		"folder": {
			"name": "sql_queries_task2"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText7",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable6",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "window1"
				},
				{
					"name": "filter1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          EmployeeKey as short,",
				"          ParentEmployeeKey as short,",
				"          EmployeeNationalIDAlternateKey as integer,",
				"          ParentEmployeeNationalIDAlternateKey as string,",
				"          SalesTerritoryKey as short,",
				"          FirstName as string,",
				"          LastName as string,",
				"          MiddleName as string,",
				"          NameStyle as boolean,",
				"          Title as string,",
				"          HireDate as date,",
				"          BirthDate as date,",
				"          LoginID as string,",
				"          EmailAddress as string,",
				"          Phone as string,",
				"          MaritalStatus as string,",
				"          EmergencyContactName as string,",
				"          EmergencyContactPhone as string,",
				"          SalariedFlag as boolean,",
				"          Gender as string,",
				"          PayFrequency as short,",
				"          BaseRate as double,",
				"          VacationHours as short,",
				"          SickLeaveHours as short,",
				"          CurrentFlag as boolean,",
				"          SalesPersonFlag as boolean,",
				"          DepartmentName as string,",
				"          StartDate as date,",
				"          EndDate as string,",
				"          Status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 window(asc(HireDate, true),",
				"     row_num = rowNumber()) ~> window1",
				"window1 filter(row_num <= 10) ~> filter1",
				"filter1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
			]
		}
	}
}