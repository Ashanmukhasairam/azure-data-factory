										"text": {
											"value": "IF EXISTS (SELECT 1 FROM File_Log_Table WHERE FileName = '@{concat(item().source,'_',formatDateTime(utcNow(),'yyyy-MM-dd'))}')\nBEGIN\n    UPDATE File_Log_Table\n    SET \n        No_Of_Changes = No_Of_Changes + 1,\n        ProcessedDate = GETUTCDATE()\n    WHERE FileName = '@{concat(item().source,'_',formatDateTime(utcNow(),'yyyy-MM-dd'))}';\nEND\nELSE\nBEGIN\n    INSERT INTO File_Log_Table (FileName, ProcessedDate, No_Of_Changes)\n    VALUES (\n        '@{concat(item().source,'_',formatDateTime(utcNow(),'yyyy-MM-dd'))}',\n        GETUTCDATE(),\n        1\n    );\nEND\n",
