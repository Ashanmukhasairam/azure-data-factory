					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureParameters": {
						"@RunID": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						},
						"@PipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"@ActivityName": {
							"value": "Load Sales Data",
							"type": "String"
						},
						"@Status": {
							"value": "0",
							"type": "Int32"
						},
						"@ErrorMessage": {
							"value": {
								"value": "@activity('load_sales_data').output.message",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				}
